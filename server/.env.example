# ============================================================
#  Lingo 后端配置
#  复制为 .env 后填写。修改后重启 dev server 生效。
#  也可以启动后在 /admin 页面里改（会覆盖这里的值，无需重启）。
# ============================================================

PORT=8787

# ---------- AI（必填） ----------
# baseurl：OpenAI 兼容接口地址。带不带 /v1 都可以。
AI_BASE_URL=https://api.deepseek.com
# apikey：只存在于后端，永远不会返回给浏览器
AI_API_KEY=
# 文本模型：生成课程 / 导师对话
AI_MODEL=deepseek-flash
# 视觉模型：识别图片里的单词短语（必须支持图片输入）
# DeepSeek 官方：deepseek-v4-flash-vision-exp
# 火山方舟：    doubao-1.5-vision-pro 等
AI_VISION_MODEL=
AI_TIMEOUT_MS=90000
AI_TEMPERATURE=0.7

# 本地无 key 时设为 1，走内置假数据跑通全流程
AI_MOCK=0

# ---------- 其他 ----------
# 留空则 /admin 页面无需令牌（仅建议本地开发）
ADMIN_TOKEN=
DATA_DIR=
